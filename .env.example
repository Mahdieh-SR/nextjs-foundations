# Client-accessible environment variables (bundled in JavaScript)
# These are visible in browser dev tools - only use for public data
NEXT_PUBLIC_APP_NAME="ACME Corporation"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only environment variables
# These are UNDEFINED in Client Components - use for sensitive config
INTERNAL_CONFIG="server-only-value"

# Multi-zone routing: where the blog app is served from.
# Left unset locally, the web app falls back to http://localhost:3001.
# In production set this per environment in the Vercel project settings.
BLOG_URL="https://your-blog.vercel.app"

# Only needed when the blog serves its assets from another origin (CDN or its
# own deployment) instead of through the web app's /blog rewrite.
ASSET_PREFIX=""

# Google Analytics measurement ID (G-XXXXXXXXXX). Public by design: it is
# visible in the page either way. Leave unset and no GA script is requested.
NEXT_PUBLIC_GA_ID=""
